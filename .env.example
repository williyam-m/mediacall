# Local development defaults. No secrets are needed on localhost.
TURN_PROVIDER=custom-turn
ICE_MODE=auto
PORT=5180
HOST=0.0.0.0
TURN_PORT=3490
TURN_PUBLIC_IP=127.0.0.1
TURN_BIND_IP=127.0.0.1
TURN_RELAY_BIND_IP=127.0.0.1
TURN_REALM=mediacall
TURN_MIN_PORT=49160
TURN_MAX_PORT=49259
TURN_MAX_ALLOCATIONS=128
TURN_MAX_ALLOCATIONS_PER_IP=8
TURN_BYTES_PER_SECOND=2000000
TURN_CREDENTIAL_TTL=3600

# Production: replace TURN_PUBLIC_IP with the relay's real public IPv4 address.
# Bind to the local NIC address, or 0.0.0.0 behind one-to-one NAT.
# TURN_PORT=3478
# TURN_BIND_IP=0.0.0.0
# TURN_RELAY_BIND_IP=0.0.0.0
# TURN_HOST=turn.example.com
# APP_ORIGIN=https://call.example.com
# TURN_SECRET=generate-at-least-32-random-characters
# APP_ACCESS_TOKEN=generate-at-least-24-random-characters
# TURN_ALLOW_PRIVATE_PEERS=false
# ALLOW_ANONYMOUS=false

# Optional native TURN-over-TLS listener. Use a trusted certificate in production.
# TURN_TLS_PORT=5349
# TURN_TLS_CERT=/absolute/path/to/fullchain.pem
# TURN_TLS_KEY=/absolute/path/to/privkey.pem

# Hosted demo: Vercel Production variables or an ignored local .env file.
# Local provider selection: npm run dev -- --turn metered
# Non-secret interactive setup: npm run dev -- --configure
# Store actual values only in Vercel/ignored .env, never source control or chat.
# CALL_BACKEND=hosted
# METERED_REALTIME_KEY_ID=sk_id_replace_with_a_new_key
# METERED_REALTIME_SECRET=sk_secret_replace_with_a_new_secret
# METERED_CHANNEL_PREFIX=mediacall/
# Enable automatic TURN injection and publish/subscribe/presence on mediacall/*.